{# templates/situation_administrative/_partial_eld.html.twig #}
<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="section-title">Recherche - Agent à la Tâche (ELD)</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="fw-bold">Matricule</label>
                <input type="text" name="Matricule" class="form-control">
            </div>
            <div class="col-md-4">
                <label class="fw-bold">Corps ELD</label>
                <select name="Corps_ELD" class="form-select">
                    {% for corps in corpsEld %}
                        <option value="{{ corps.codeCorps }}">{{ corps.libelleCorps }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label class="fw-bold">Majoration</label>
                <select name="Majoration" class="form-select">
                    {% for maj in majorations %}
                        <option value="{{ maj }}">{{ maj }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="fw-bold">Indice CT</label>
                <select name="Indice_ct" class="form-select">
                    {% for ct in indiceCtList %}
                        <option value="{{ ct.indiceCt }}">{{ ct.indiceCt }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>
</div>
