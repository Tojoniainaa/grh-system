{% extends 'base.html.twig' %}

{% block title %}Accueil — GRH System | Ministère des Travaux Publics{% endblock %}

{% block stylesheets %}
    <style>
        .hero {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #1d4ed8 100%);
            border-radius: 20px;
            padding: 3rem 2.5rem;
            color: white;
            position: relative;
            overflow: hidden;
            margin-bottom: 2rem;
            box-shadow: 0 20px 40px -10px rgba(15, 44, 89, 0.3);
        }

        .hero::before {
            content: '';
            position: absolute;
            top: -30%;
            right: -10%;
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            border-radius: 50%;
        }

        .hero h1 {
            font-weight: 700;
            font-size: 2.1rem;
            margin-bottom: 0.4rem;
            letter-spacing: -0.02em;
        }

        .hero .subtitle {
            font-size: 1.15rem;
            opacity: 0.9;
            margin-bottom: 0.25rem;
        }

        .hero .lead {
            opacity: 0.75;
            font-size: 1rem;
            margin: 0;
        }

        /* Stats cards */
        .stat-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 10px 25px -5px rgba(15, 44, 89, 0.06);
            transition: all 0.25s ease;
            height: 100%;
            position: relative;
            overflow: hidden;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 35px -5px rgba(15, 44, 89, 0.12);
        }

        .stat-card .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            margin-bottom: 1rem;
        }

        .stat-card .stat-value {
            font-size: 2rem;
            font-weight: 700;
            color: #0f172a;
            line-height: 1.1;
            margin-bottom: 0.25rem;
        }

        .stat-card .stat-label {
            font-size: 0.9rem;
            color: #64748b;
            font-weight: 500;
        }

        .icon-blue   { background: #dbeafe; color: #1d4ed8; }
        .icon-green  { background: #d1fae5; color: #059669; }
        .icon-amber  { background: #fef3c7; color: #d97706; }
        .icon-rose   { background: #ffe4e6; color: #e11d48; }

        /* Quick access */
        .quick-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(15, 44, 89, 0.06);
            overflow: hidden;
        }

        .quick-header {
            background: linear-gradient(to right, #f8fafc, #f1f5f9);
            border-bottom: 1px solid #e2e8f0;
            padding: 1.1rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .quick-header .icon-box {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .quick-header h5 {
            margin: 0;
            font-weight: 600;
            font-size: 1.05rem;
            color: #0f172a;
        }

        .quick-body {
            padding: 1.5rem;
        }

        .quick-btn {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 1rem 1.25rem;
            border-radius: 12px;
            text-decoration: none;
            color: #1e293b;
            font-weight: 500;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            transition: all 0.2s ease;
            margin-bottom: 0.75rem;
        }

        .quick-btn:last-child {
            margin-bottom: 0;
        }

        .quick-btn:hover {
            background: #eff6ff;
            border-color: #bfdbfe;
            color: #1d4ed8;
            transform: translateX(4px);
        }

        .quick-btn .btn-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .btn-icon.blue   { background: #dbeafe; color: #1d4ed8; }
        .btn-icon.green  { background: #d1fae5; color: #059669; }
        .btn-icon.slate  { background: #e2e8f0; color: #475569; }

        .quick-btn span {
            flex: 1;
        }

        .quick-btn i.arrow {
            color: #94a3b8;
            font-size: 0.9rem;
        }

        .footer-note {
            text-align: center;
            color: #94a3b8;
            font-size: 0.875rem;
            margin-top: 2.5rem;
        }
    </style>
{% endblock %}

{% block body %}

    {# ===== HERO ===== #}
    <div class="hero">
        <div class="position-relative">
            <h1>
                <i class="bi bi-building me-2"></i>
                Ministère des Travaux Publics
            </h1>
            <p class="subtitle">ANOS — Antananarivo</p>
            <p class="lead">Système de Gestion des Ressources Humaines</p>
        </div>
    </div>

    {# ===== STATISTIQUES ===== #}
    <div class="row g-4 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon icon-blue">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="stat-value"> {{totalPersonnes}}</div>
                <div class="stat-label">Agents</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon icon-amber">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
                <div class="stat-value"> {{ parCategorie|length }}</div>
                <div class="stat-label">Categorie</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon icon-rose">
                    <i class="bi bi-calendar3"></i>
                </div>
                <div class="stat-value">{{ anneeExercice }}</div>
                <div class="stat-label">Année d’exercice</div>
            </div>
        </div>
    </div>
    <div class="row g-4 mb-4">

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon icon-green">
                    <i class="bi bi-building"></i>
                </div>

                <div class="stat-value">{{ totalDirections }}</div>
                <div class="stat-label">Directions</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon icon-amber">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>

                <div class="stat-value">{{ totalServices }}</div>
                <div class="stat-label">Services</div>
            </div>
        </div>

    </div>
    <div class="row g-4">

        <div class="col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-person-badge me-2"></i>
                        Répartition par statut
                    </h5>
                </div>

                <div class="card-body">

                    {% for item in parStatus %}

                        <div class="d-flex justify-content-between align-items-center mb-3">

                        <span>
                            {{ item.status }}
                        </span>

                            <span class="badge bg-primary rounded-pill">
                            {{ item.total }}
                        </span>

                        </div>

                    {% else %}

                        <div class="text-muted">
                            Aucun statut trouvé.
                        </div>

                    {% endfor %}

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-diagram-3 me-2"></i>
                        Répartition par catégorie
                    </h5>
                </div>

                <div class="card-body">

                    {% for item in parCategorie %}

                        <div class="d-flex justify-content-between align-items-center mb-3">

                        <span>
                            Catégorie {{ item.categorie }}
                        </span>

                            <span class="badge bg-success rounded-pill">
                            {{ item.total }}
                        </span>

                        </div>

                    {% else %}

                        <div class="text-muted">
                            Aucune catégorie trouvée.
                        </div>

                    {% endfor %}

                </div>

            </div>

        </div>

    </div>

    {# ===== ACCÈS RAPIDES ===== #}
    <div class="quick-card">
        <div class="quick-header">
            <div class="icon-box">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div>
                <h5>Accès rapides</h5>
                <small class="text-muted">Raccourcis vers les modules principaux</small>
            </div>
        </div>

        <div class="quick-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <a href="{{ path('situation_administrative_index') }}" class="quick-btn">
                        <div class="btn-icon blue">
                            <i class="bi bi-briefcase"></i>
                        </div>
                        <span>Situation Administrative</span>
                        <i class="bi bi-chevron-right arrow"></i>
                    </a>
                </div>

                <div class="col-md-4">
                    <a href="{{ path('agents_ajout') }}" class="quick-btn">
                        <div class="btn-icon green">
                            <i class="bi bi-person-plus"></i>
                        </div>
                        <span>Ajouter un agent</span>
                        <i class="bi bi-chevron-right arrow"></i>
                    </a>
                </div>

                <div class="col-md-4">
                    <a href="#" class="quick-btn">
                        <div class="btn-icon slate">
                            <i class="bi bi-list-ul"></i>
                        </div>
                        <span>Liste des agents</span>
                        <i class="bi bi-chevron-right arrow"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="footer-note">
        © {{ "now"|date("Y") }} — Ministère des Travaux Publics · ANOS Antananarivo
    </div>

{% endblock %}
