{% extends 'base.html.twig' %}

{% block title %}Accueil - Ministère des Travaux Publics{% endblock %}

{% block body %}

    <div class="container-fluid py-5">

        <div class="text-center mb-5">
            <h1 class="display-4 fw-bold text-primary">
                Ministère des Travaux Publics
            </h1>

            <h3 class="text-secondary">
                ANOS - Antananarivo
            </h3>

            <p class="lead">
                Système de Gestion du Personnel
            </p>
        </div>

        <div class="row text-center mb-5">

            <div class="col-md-3">
                <div class="card shadow border-0">
                    <div class="card-body">
                        <h1 class="text-primary">150</h1>
                        <h5>Agents</h5>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow border-0">
                    <div class="card-body">
                        <h1 class="text-success">12</h1>
                        <h5>Directions</h5>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow border-0">
                    <div class="card-body">
                        <h1 class="text-warning">25</h1>
                        <h5>Services</h5>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow border-0">
                    <div class="card-body">
                        <h1 class="text-danger">2026</h1>
                        <h5>Année d'exercice</h5>
                    </div>
                </div>
            </div>

        </div>

        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white">
                Accès Rapides
            </div>

            <div class="card-body text-center">

                <a href=""
                   class="btn btn-primary m-2">
                    Fiche individuelle
                </a>

                <a href=""
                   class="btn btn-success m-2">
                    Ajouter un agent
                </a>

                <a href=""
                   class="btn btn-secondary m-2">
                    Liste des agents
                </a>

            </div>
        </div>

        <div class="text-center mt-5 text-muted">
            © 2026 Ministère des Travaux Publics - ANOS Antananarivo
        </div>

    </div>

{% endblock %}
