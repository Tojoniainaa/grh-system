{% extends 'base.html.twig' %}

{% block title %}Modifier demande de congé — GRH System{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 1.75rem;
        }

        .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 0.25rem;
        }

        .page-subtitle {
            color: #64748b;
            font-size: 0.95rem;
        }

        .modern-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 10px 30px -5px rgba(15, 44, 89, 0.07);
            overflow: hidden;
        }

        .card-header-modern {
            background: linear-gradient(to right, #f8fafc, #f1f5f9);
            border-bottom: 1px solid #e2e8f0;
            padding: 1.1rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .card-header-modern .icon-box {
            width: 40px;
            height: 40px;
            border-radius: 11px;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
        }

        .card-header-modern h5 {
            margin: 0;
            font-weight: 600;
            font-size: 1.1rem;
            color: #0f172a;
        }

        .card-body-modern {
            padding: 0.75rem;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-size: 0.95rem;
            font-weight: 600;
            color: #1e40af;
            margin-bottom: 0.2rem;
            padding-bottom: 0.0rem;
            border-bottom: 2px solid #dbeafe;
        }

        .section-title i {
            font-size: 1.1rem;
        }

        .form-label {
            font-weight: 500;
            font-size: 0.875rem;
            color: #334155;
            margin-bottom: 0.35rem;
        }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: 0.3rem 0.3rem;
            font-size: 0.925rem;
            transition: all 0.2s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }

        .btn-ghost {
            background: transparent;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            padding: 0.4rem 1rem;
            font-weight: 500;
            color: #64748b;
            transition: all 0.2s;
        }

        .btn-ghost:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: #1e293b;
        }

        .btn-success-modern {
            background: linear-gradient(135deg, #059669, #10b981);
            border: none;
            border-radius: 10px;
            padding: 0.2rem 2rem;
            font-weight: 600;
            color: white;
            box-shadow: 0 4px 14px rgba(5, 150, 105, 0.3);
            transition: all 0.2s;
        }

        .btn-success-modern:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(5, 150, 105, 0.4);
            color: white;
        }

        .form-divider {
            height: 1px;
            background: linear-gradient(to right, transparent, #e2e8f0, transparent);
            margin: 0.5rem 0;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">
            <i class="bi bi-pencil-square text-primary me-2"></i>
            Modifier la demande #{{ demande.id }}
        </h1>
        <p class="page-subtitle">Modifiez les informations de la demande de congé</p>
    </div>

    <div class="modern-card">
        <div class="card-header-modern">
            <div class="icon-box">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div>
                <h5>Informations de la demande</h5>
                <small class="text-muted">Tous les champs marqués d’un * sont obligatoires</small>
            </div>
        </div>

        <div class="card-body-modern">
            <form method="post">

                <div class="row g-4">

                    {# ===== INFORMATIONS PRINCIPALES ===== #}
                    <div class="col-12">
                        <div class="section-title">
                            <i class="bi bi-person-badge"></i>
                            Agent & Période
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Matricule <span class="text-danger">*</span></label>
                        <input type="number" name="matricule" class="form-control" required
                               value="{{ demande.matricule }}">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Date de demande <span class="text-danger">*</span></label>
                        <input type="date" name="date_demande" class="form-control" required
                               value="{{ demande.dateDemande|date('Y-m-d') }}">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Durée (jours) <span class="text-danger">*</span></label>
                        <input type="number" name="duree" class="form-control" required min="1"
                               value="{{ demande.duree }}">
                    </div>

                    <div class="col-12">
                        <div class="form-divider"></div>
                    </div>

                    {# ===== DATES ===== #}
                    <div class="col-12">
                        <div class="section-title">
                            <i class="bi bi-calendar-range"></i>
                            Dates de congé
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Date de départ <span class="text-danger">*</span></label>
                        <input type="date" name="date_depart" class="form-control" required
                               value="{{ demande.dateDepart|date('Y-m-d') }}">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Date de retour <span class="text-danger">*</span></label>
                        <input type="date" name="date_retour" class="form-control" required
                               value="{{ demande.dateRetour|date('Y-m-d') }}">
                    </div>

                    <div class="col-12">
                        <div class="form-divider"></div>
                    </div>

                    {# ===== DÉTAILS ===== #}
                    <div class="col-12">
                        <div class="section-title">
                            <i class="bi bi-geo-alt"></i>
                            Détails
                        </div>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label">Lieu de jouissance <span class="text-danger">*</span></label>
                        <input type="text" name="lieu_jouissance" class="form-control" required
                               value="{{ demande.lieuJouissance }}">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Jours restants</label>
                        <input type="number" name="nb_jours_reste" class="form-control" min="0"
                               value="{{ demande.nbJoursReste }}">
                    </div>

                    <div class="col-12">
                        <label class="form-label">Motifs <span class="text-danger">*</span></label>
                        <textarea name="motifs" class="form-control" rows="3" required>{{ demande.motifs }}</textarea>
                    </div>
                </div>

                {# Boutons #}
                <div class="d-flex justify-content-end gap-3 mt-5 pt-2">
                    <a href="{{ path('conge_index') }}" class="btn btn-ghost">
                        <i class="bi bi-arrow-left me-1"></i>
                        Annuler
                    </a>
                    <button type="submit" class="btn btn-success-modern">
                        <i class="bi bi-check2-circle me-1"></i>
                        Enregistrer les modifications
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
