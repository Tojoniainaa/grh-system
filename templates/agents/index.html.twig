{% extends 'base.html.twig' %}

{% block title %}Liste des agents{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .page-header-avancement {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 60%, #1d4ed8 100%);
            color: white;
            padding: 1.5rem 0;
            margin: -1.75rem -1.75rem 1.75rem;
            padding-left: 1.75rem;
            padding-right: 1.75rem;
            box-shadow: 0 8px 25px rgba(15, 44, 89, 0.25);
        }
        .page-header-avancement h1 {
            font-size: 1.45rem;
            font-weight: 700;
            margin: 0 0 0.2rem;
        }
        .page-header-avancement p {
            margin: 0;
            opacity: 0.85;
            font-size: 0.95rem;
        }
        .modern-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 10px 30px -5px rgba(15, 44, 89, 0.07);
            overflow: hidden;
            margin-bottom: 1.5rem;
        }
        .card-header-modern {
            background: linear-gradient(to right, #f8fafc, #f1f5f9);
            border-bottom: 1px solid #e2e8f0;
            padding: 1rem 1.35rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .card-header-modern .icon-box {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }
        .card-header-modern h5 {
            margin: 0;
            font-weight: 600;
            font-size: 1.05rem;
            color: #0f172a;
        }
        .card-body-modern {
            padding: 1.35rem;
        }
        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: 0.55rem 0.9rem;
        }
        .form-control:focus, .form-select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }
        .btn-search {
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            border: none;
            color: white;
            border-radius: 10px;
            padding: 0.55rem 1.2rem;
            font-weight: 600;
        }
        .btn-search:hover {
            color: white;
            opacity: 0.95;
        }
        .table thead th {
            background: #f8fafc;
            font-weight: 600;
            font-size: 0.85rem;
            color: #475569;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.85rem 1rem;
            white-space: nowrap;
        }
        .table tbody td {
            padding: 0.8rem 1rem;
            vertical-align: middle;
            font-size: 0.9rem;
        }
        .table tbody tr:hover {
            background: #f8fafc;
        }
        .badge-matricule {
            background: #dbeafe;
            color: #1d4ed8;
            font-weight: 600;
            padding: 0.3rem 0.65rem;
            border-radius: 8px;
            font-size: 0.85rem;
        }
        .btn-action {
            border-radius: 8px;
            font-size: 0.8rem;
            padding: 0.3rem 0.65rem;
            margin: 0.1rem;
            font-weight: 500;
        }
        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: #64748b;
        }
        .avatar-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.85rem;
            flex-shrink: 0;
            overflow: hidden;
        }
        .avatar-circle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .badge-sexe-m {
            background: #dbeafe;
            color: #1d4ed8;
            font-weight: 600;
            padding: 0.25rem 0.55rem;
            border-radius: 6px;
            font-size: 0.8rem;
        }
        .badge-sexe-f {
            background: #fce7f3;
            color: #be185d;
            font-weight: 600;
            padding: 0.25rem 0.55rem;
            border-radius: 6px;
            font-size: 0.8rem;
        }
    </style>
{% endblock %}

{% block body %}

    <div class="page-header-avancement">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><i class="bi bi-people-fill me-2"></i> Liste des agents</h1>
                <p>Gestion des agents enregistrés dans le système</p>
            </div>
            <a href="{{ path('agents_ajout') }}" class="btn btn-light btn-sm fw-semibold">
                <i class="bi bi-plus-lg me-1"></i> Nouvel agent
            </a>
        </div>
    </div>

    {# ===== RECHERCHE ===== #}
    <div class="modern-card">
        <div class="card-header-modern">
            <div class="icon-box"><i class="bi bi-funnel"></i></div>
            <div>
                <h5>Recherche</h5>
                <small class="text-muted">Rechercher par nom, prénom, matricule, CIN ou contact</small>
            </div>
        </div>
        <div class="card-body-modern">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label fw-medium">Recherche</label>
                    <input type="text" name="q" class="form-control"
                           placeholder="Nom, prénom, matricule, CIN, contact..."
                           value="{{ q }}">
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-search">
                        <i class="bi bi-search me-1"></i> Rechercher
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# ===== LISTE ===== #}
    <div class="modern-card">
        <div class="card-header-modern">
            <div class="icon-box"><i class="bi bi-list-ul"></i></div>
            <div>
                <h5>Agents enregistrés</h5>
                <small class="text-muted">{{ agents|length }} agent(s) trouvé(s)</small>
            </div>
        </div>

        <div class="card-body-modern p-0">
            {% if agents is empty %}
                <div class="empty-state">
                    <i class="bi bi-inbox display-5 d-block mb-3 opacity-50"></i>
                    <p class="mb-3">Aucun agent trouvé.</p>
                    <a href="{{ path('agents_ajout') }}" class="btn btn-search">
                        <i class="bi bi-plus-lg me-1"></i> Ajouter un agent
                    </a>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                        <tr>
                            <th class="ps-4">Photo</th>
                            <th>Nom & Prénom</th>
                            <th>Matricule</th>
                            <th>Sexe</th>
                            <th>Contact</th>
                            <th>CIN</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for agent in agents %}
                            <tr>
                                <td class="ps-4">
                                    <div class="avatar-circle">
                                        {% if agent.nomPhotos %}
                                            <img src="{{ asset('uploads/photos/' ~ agent.nomPhotos) }}" alt="Photo">
                                        {% else %}
                                            {{ agent.nom|first|upper }}{{ agent.prenom|first|upper }}
                                        {% endif %}
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold">{{ agent.nom }} {{ agent.prenom }}</div>
                                    {% if agent.dateNaissance %}
                                        <small class="text-muted">{{ agent.dateNaissance|date('d/m/Y') }}</small>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge-matricule">{{ agent.matricule }}</span>
                                </td>
                                <td>
                                    {% if agent.sexe == 'M' %}
                                        <span class="badge-sexe-m">Homme</span>
                                    {% elseif agent.sexe == 'F' %}
                                        <span class="badge-sexe-f">Femme</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ agent.sexe }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ agent.contact ?? '—' }}</td>
                                <td>{{ agent.cin ?? '—' }}</td>
                                <td class="text-end pe-4">
                                    <a href="{{ path('app_agents_show', {'id': agent.id}) }}"
                                       class="btn btn-outline-primary btn-action" title="Voir">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('app_agents_edit', {'id': agent.id}) }}"
                                       class="btn btn-outline-secondary btn-action" title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post"
                                          action="{{ path('app_agents_delete', {'id': agent.id}) }}"
                                          class="d-inline"
                                          onsubmit="return confirm('Voulez-vous vraiment supprimer cet agent ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ agent.id) }}">
                                        <button type="submit" class="btn btn-outline-danger btn-action" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
    {# ========== PAGINATION ========== #}
    {% if totalPages > 1 %}
        <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
            <div class="text-muted small">
                Page {{ currentPage }} sur {{ totalPages }}
                {% if q %} — Recherche : « {{ q }} »{% endif %}
            </div>

            <nav>
                <ul class="pagination pagination-sm mb-0">
                    {# Précédent #}
                    <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                        <a class="page-link"
                           href="{{ path('agents_index', {page: currentPage - 1, q: q}) }}">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    {% for page in 1..totalPages %}
                        {% if page == currentPage %}
                            <li class="page-item active">
                                <span class="page-link">{{ page }}</span>
                            </li>
                        {% elseif page <= 2 or page > totalPages - 2 or (page >= currentPage - 1 and page <= currentPage + 1) %}
                            <li class="page-item">
                                <a class="page-link"
                                   href="{{ path('agents_index', {page: page, q: q}) }}">
                                    {{ page }}
                                </a>
                            </li>
                        {% elseif page == 3 or page == totalPages - 2 %}
                            <li class="page-item disabled">
                                <span class="page-link">…</span>
                            </li>
                        {% endif %}
                    {% endfor %}

                    {# Suivant #}
                    <li class="page-item {{ currentPage == totalPages ? 'disabled' : '' }}">
                        <a class="page-link"
                           href="{{ path('agents_index', {page: currentPage + 1, q: q}) }}">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    {% endif %}

{% endblock %}
